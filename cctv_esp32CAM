// ============================================================
// ฟังก์ชันแสดงหน้าเว็บไซต์หลัก
// ============================================================

static esp_err_t indexHandler(httpd_req_t *req)
{
    // บอก Browser ว่าข้อมูลที่ส่งไปคือ HTML
    httpd_resp_set_type(
        req,
        "text/html"
    );

    // ไม่ให้ Browser จำ Cache
    // เพื่อให้โหลดข้อมูลใหม่ทุกครั้ง
    httpd_resp_set_hdr(
        req,
        "Cache-Control",
        "no-cache"
    );

    // ส่ง HTML ไปยัง Browser
    return httpd_resp_send(
        req,
        INDEX_HTML,
        HTTPD_RESP_USE_STRLEN
    );
}


// ============================================================
// ฟังก์ชัน Video Streaming
// ============================================================
//
// หลักการทำงาน:
// 1. กล้องถ่ายภาพ JPEG
// 2. ส่งภาพไป Browser
// 3. ถ่ายภาพใหม่
// 4. ส่งต่อเนื่องซ้ำ ๆ
//
// จึงดูเหมือนเป็น Video
// รูปแบบนี้เรียกว่า MJPEG
// ============================================================

static esp_err_t streamHandler(httpd_req_t *req)
{
    // ตัวแปรเก็บ Frame จากกล้อง
    camera_fb_t *fb = NULL;

    // ตัวแปรตรวจสอบ Error
    esp_err_t res = ESP_OK;

    // Buffer สำหรับ Header แต่ละ Frame
    char partBuffer[64];


    // กำหนดชนิดข้อมูลเป็น MJPEG Streaming
    res = httpd_resp_set_type(
        req,
        STREAM_CONTENT_TYPE
    );


    // หากตั้งค่าไม่สำเร็จให้หยุด
    if(res != ESP_OK)
    {
        return res;
    }


    // อนุญาตให้หน้าเว็บเรียก Stream ได้
    httpd_resp_set_hdr(
        req,
        "Access-Control-Allow-Origin",
        "*"
    );


    // วนส่งภาพต่อเนื่อง
    while(true)
    {

        // ขอภาพล่าสุดจากกล้อง
        fb = esp_camera_fb_get();


        // ตรวจสอบว่าได้ภาพหรือไม่
        if(!fb)
        {
            Serial.println(
                "Camera capture failed"
            );

            res = ESP_FAIL;
        }

        else
        {

            // ------------------------------------------------
            // ส่ง Boundary เพื่อแบ่งแต่ละ Frame
            // ------------------------------------------------

            res = httpd_resp_send_chunk(
                req,
                STREAM_BOUNDARY,
                strlen(STREAM_BOUNDARY)
            );


            // ------------------------------------------------
            // ส่ง Header ของภาพ
            // ------------------------------------------------

            if(res == ESP_OK)
            {

                size_t hlen =
                    snprintf(
                        partBuffer,
                        sizeof(partBuffer),
                        STREAM_PART,
                        fb->len
                    );


                res =
                    httpd_resp_send_chunk(
                        req,
                        partBuffer,
                        hlen
                    );
            }


            // ------------------------------------------------
            // ส่งข้อมูลภาพ JPEG ไป Browser
            // ------------------------------------------------

            if(res == ESP_OK)
            {

                res =
                    httpd_resp_send_chunk(
                        req,
                        (const char*)fb->buf,
                        fb->len
                    );
            }


            // ------------------------------------------------
            // คืน Frame Buffer ให้กล้อง
            // ------------------------------------------------

            esp_camera_fb_return(fb);

            fb = NULL;
        }


        // หากมือถือหลุดการเชื่อมต่อ
        // หรือเกิด Error ให้หยุด Loop
        if(res != ESP_OK)
        {
            break;
        }


        // หน่วงเล็กน้อย
        // ลดภาระ CPU
        delay(10);
    }


    return res;
}


// ============================================================
// ฟังก์ชันถ่ายภาพนิ่ง
// ============================================================

static esp_err_t captureHandler(httpd_req_t *req)
{
    // ถ่ายภาพจากกล้อง
    camera_fb_t *fb =
        esp_camera_fb_get();


    // หากไม่สามารถถ่ายภาพได้
    if(!fb)
    {

        Serial.println(
            "Camera capture failed"
        );

        // ส่ง Error 500
        httpd_resp_send_500(req);

        return ESP_FAIL;
    }


    // กำหนดชนิดข้อมูลเป็น JPEG
    httpd_resp_set_type(
        req,
        "image/jpeg"
    );


    // ตั้งชื่อไฟล์
    httpd_resp_set_hdr(
        req,
        "Content-Disposition",
        "inline; filename=ESP32-CAM.jpg"
    );


    // ป้องกัน Browser ใช้ภาพเก่าจาก Cache
    httpd_resp_set_hdr(
        req,
        "Cache-Control",
        "no-cache"
    );


    // ส่งภาพไปยัง Browser
    esp_err_t result =
        httpd_resp_send(
            req,
            (const char*)fb->buf,
            fb->len
        );


    // คืน Buffer ให้กล้อง
    esp_camera_fb_return(fb);


    return result;
}


// ============================================================
// ฟังก์ชันเปิด / ปิด Flash
// ============================================================

static esp_err_t flashHandler(httpd_req_t *req)
{
    // Buffer สำหรับเก็บค่าที่ส่งมาจาก URL
    char query[32];

    char value[8];


    // อ่าน Query String
    //
    // ตัวอย่าง:
    // /flash?state=1
    //
    // state=1 คือเปิด
    // state=0 คือปิด
    if(
        httpd_req_get_url_query_str(
            req,
            query,
            sizeof(query)
        ) == ESP_OK
    )
    {

        // อ่านค่า state
        if(
            httpd_query_key_value(
                query,
                "state",
                value,
                sizeof(value)
            ) == ESP_OK
        )
        {

            // หากค่าเป็น 1
            // เปิด Flash
            if(atoi(value) == 1)
            {

                flashState = true;

                digitalWrite(
                    FLASH_LED_PIN,
                    HIGH
                );

                Serial.println(
                    "Flash ON"
                );
            }

            // หากไม่ใช่ 1
            // ปิด Flash
            else
            {

                flashState = false;

                digitalWrite(
                    FLASH_LED_PIN,
                    LOW
                );

                Serial.println(
                    "Flash OFF"
                );
            }
        }
    }


    // ส่งผลกลับเป็นข้อความธรรมดา
    httpd_resp_set_type(
        req,
        "text/plain"
    );


    // ส่งสถานะปัจจุบันกลับ Browser
    return httpd_resp_sendstr(
        req,
        flashState ? "ON" : "OFF"
    );
}


// ============================================================
// ฟังก์ชันเปลี่ยนความละเอียดของกล้อง
// ============================================================

static esp_err_t resolutionHandler(httpd_req_t *req)
{
    // Buffer สำหรับ Query
    char query[64];

    // Buffer สำหรับชื่อ Resolution
    char sizeValue[20];


    // อ่าน Query String
    if(
        httpd_req_get_url_query_str(
            req,
            query,
            sizeof(query)
        ) != ESP_OK
    )
    {
        return httpd_resp_send_404(req);
    }


    // อ่านค่า size
    //
    // ตัวอย่าง:
    // /resolution?size=VGA
    if(
        httpd_query_key_value(
            query,
            "size",
            sizeValue,
            sizeof(sizeValue)
        ) != ESP_OK
    )
    {
        return httpd_resp_send_404(req);
    }


    // อ่านตัวควบคุม Sensor ของกล้อง
    sensor_t *sensor =
        esp_camera_sensor_get();


    // ตัวแปรเก็บขนาดภาพ
    framesize_t frameSize;


    // --------------------------------------------------------
    // QVGA = 320 × 240
    // --------------------------------------------------------

    if(
        strcmp(
            sizeValue,
            "QVGA"
        ) == 0
    )
    {
        frameSize =
            FRAMESIZE_QVGA;
    }


    // --------------------------------------------------------
    // VGA = 640 × 480
    // --------------------------------------------------------

    else if(
        strcmp(
            sizeValue,
            "VGA"
        ) == 0
    )
    {
        frameSize =
            FRAMESIZE_VGA;
    }


    // --------------------------------------------------------
    // SVGA = 800 × 600
    // --------------------------------------------------------

    else if(
        strcmp(
            sizeValue,
            "SVGA"
        ) == 0
    )
    {
        frameSize =
            FRAMESIZE_SVGA;
    }


    // --------------------------------------------------------
    // XGA = 1024 × 768
    // --------------------------------------------------------

    else if(
        strcmp(
            sizeValue,
            "XGA"
        ) == 0
    )
    {
        frameSize =
            FRAMESIZE_XGA;
    }


    // --------------------------------------------------------
    // SXGA = 1280 × 1024
    // --------------------------------------------------------

    else if(
        strcmp(
            sizeValue,
            "SXGA"
        ) == 0
    )
    {
        frameSize =
            FRAMESIZE_SXGA;
    }


    // หากไม่ได้ค่าอะไรมา
    // ใช้ VGA เป็นค่าเริ่มต้น
    else
    {
        frameSize =
            FRAMESIZE_VGA;
    }


    // เปลี่ยน Resolution ของกล้อง
    sensor->set_framesize(
        sensor,
        frameSize
    );


    // แสดงค่าที่ Serial Monitor
    Serial.print(
        "Resolution changed : "
    );

    Serial.println(
        sizeValue
    );


    // ส่ง OK กลับ Browser
    return httpd_resp_sendstr(
        req,
        "OK"
    );
}


// ============================================================
// ฟังก์ชัน Restart ESP32-CAM
// ============================================================

static esp_err_t restartHandler(httpd_req_t *req)
{
    // แจ้ง Browser ก่อน Restart
    httpd_resp_sendstr(
        req,
        "Restarting..."
    );


    // รอเล็กน้อยเพื่อให้ข้อความส่งเสร็จ
    delay(500);


    // Restart ESP32
    ESP.restart();


    return ESP_OK;
}


// ============================================================
// ฟังก์ชันเริ่ม Web Server
// ============================================================

void startCameraServer()
{

    // ========================================================
    // Server หลัก
    // Port 80
    // ========================================================

    // โหลดค่ามาตรฐานของ HTTP Server
    httpd_config_t config =
        HTTPD_DEFAULT_CONFIG();


    // ตั้ง Server หลักเป็น Port 80
    config.server_port = 80;


    // --------------------------------------------------------
    // หน้าเว็บไซต์ /
    // --------------------------------------------------------

    httpd_uri_t index_uri = {

        .uri       = "/",

        .method    = HTTP_GET,

        .handler   = indexHandler,

        .user_ctx  = NULL
    };


    // --------------------------------------------------------
    // ถ่ายภาพ /capture
    // --------------------------------------------------------

    httpd_uri_t capture_uri = {

        .uri       = "/capture",

        .method    = HTTP_GET,

        .handler   = captureHandler,

        .user_ctx  = NULL
    };


    // --------------------------------------------------------
    // Flash /flash
    // --------------------------------------------------------

    httpd_uri_t flash_uri = {

        .uri       = "/flash",

        .method    = HTTP_GET,

        .handler   = flashHandler,

        .user_ctx  = NULL
    };


    // --------------------------------------------------------
    // Resolution /resolution
    // --------------------------------------------------------

    httpd_uri_t resolution_uri = {

        .uri       = "/resolution",

        .method    = HTTP_GET,

        .handler   = resolutionHandler,

        .user_ctx  = NULL
    };


    // --------------------------------------------------------
    // Restart /restart
    // --------------------------------------------------------

    httpd_uri_t restart_uri = {

        .uri       = "/restart",

        .method    = HTTP_GET,

        .handler   = restartHandler,

        .user_ctx  = NULL
    };


    Serial.println(
        "Starting Web Server Port 80..."
    );


    // เริ่ม Server Port 80
    if(
        httpd_start(
            &camera_httpd,
            &config
        ) == ESP_OK
    )
    {

        // ลงทะเบียนหน้าเว็บไซต์
        httpd_register_uri_handler(
            camera_httpd,
            &index_uri
        );


        // ลงทะเบียนคำสั่งถ่ายภาพ
        httpd_register_uri_handler(
            camera_httpd,
            &capture_uri
        );


        // ลงทะเบียนคำสั่ง Flash
        httpd_register_uri_handler(
            camera_httpd,
            &flash_uri
        );


        // ลงทะเบียนปรับ Resolution
        httpd_register_uri_handler(
            camera_httpd,
            &resolution_uri
        );


        // ลงทะเบียน Restart
        httpd_register_uri_handler(
            camera_httpd,
            &restart_uri
        );
    }


    // ========================================================
    // Server Video Streaming
    // Port 81
    // ========================================================

    // เปลี่ยน Port จาก 80 เป็น 81
    config.server_port = 81;

    // Control Port ต้องไม่ชนกับ Server หลัก
    config.ctrl_port += 1;


    // กำหนด URL /stream
    httpd_uri_t stream_uri = {

        .uri       = "/stream",

        .method    = HTTP_GET,

        .handler   = streamHandler,

        .user_ctx  = NULL
    };


    Serial.println(
        "Starting Stream Server Port 81..."
    );


    // เริ่ม Server Stream
    if(
        httpd_start(
            &stream_httpd,
            &config
        ) == ESP_OK
    )
    {

        // ลงทะเบียน /stream
        httpd_register_uri_handler(
            stream_httpd,
            &stream_uri
        );
    }
}


// ============================================================
// ฟังก์ชันตั้งค่ากล้อง
// ============================================================

bool setupCamera()
{

    // สร้างตัวแปร Configuration
    camera_config_t config;


    // ========================================================
    // ตั้งค่า PWM Clock สำหรับกล้อง
    // ========================================================

    config.ledc_channel =
        LEDC_CHANNEL_0;

    config.ledc_timer =
        LEDC_TIMER_0;


    // ========================================================
    // กำหนดขารับข้อมูลภาพ
    // ========================================================

    config.pin_d0 = Y2_GPIO_NUM;
    config.pin_d1 = Y3_GPIO_NUM;
    config.pin_d2 = Y4_GPIO_NUM;
    config.pin_d3 = Y5_GPIO_NUM;

    config.pin_d4 = Y6_GPIO_NUM;
    config.pin_d5 = Y7_GPIO_NUM;
    config.pin_d6 = Y8_GPIO_NUM;
    config.pin_d7 = Y9_GPIO_NUM;


    // ========================================================
    // Clock
    // ========================================================

    config.pin_xclk =
        XCLK_GPIO_NUM;

    config.pin_pclk =
        PCLK_GPIO_NUM;


    // ========================================================
    // สัญญาณ Sync
    // ========================================================

    config.pin_vsync =
        VSYNC_GPIO_NUM;

    config.pin_href =
        HREF_GPIO_NUM;


    // ========================================================
    // SCCB
    // ใช้ ESP32 ติดต่อและตั้งค่ากล้อง
    // ========================================================

    config.pin_sccb_sda =
        SIOD_GPIO_NUM;

    config.pin_sccb_scl =
        SIOC_GPIO_NUM;


    // ========================================================
    // Power / Reset
    // ========================================================

    config.pin_pwdn =
        PWDN_GPIO_NUM;

    config.pin_reset =
        RESET_GPIO_NUM;


    // ========================================================
    // ความถี่ Clock กล้อง
    // ========================================================

    config.xclk_freq_hz =
        20000000;


    // ========================================================
    // ให้กล้องส่งภาพเป็น JPEG
    //
    // JPEG เหมาะกับ Streaming
    // เพราะใช้ข้อมูลน้อยกว่า RGB
    // ========================================================

    config.pixel_format =
        PIXFORMAT_JPEG;


    // ========================================================
    // ตรวจสอบ PSRAM
    // ========================================================

    if(psramFound())
    {

        Serial.println(
            "PSRAM Found"
        );


        // หากมี PSRAM
        // ใช้ความละเอียด VGA เป็นค่าเริ่มต้น
        config.frame_size =
            FRAMESIZE_VGA;


        // คุณภาพ JPEG
        //
        // ค่ายิ่งต่ำ = ภาพยิ่งชัด
        // แต่ไฟล์ใหญ่ขึ้น
        config.jpeg_quality = 10;


        // ใช้ Frame Buffer 2 ชุด
        // ช่วยให้ Streaming ลื่นขึ้น
        config.fb_count = 2;


        // เลือก Frame ล่าสุดเสมอ
        config.grab_mode =
            CAMERA_GRAB_LATEST;

    }

    else
    {

        Serial.println(
            "PSRAM NOT FOUND"
        );


        // หากไม่มี PSRAM
        // ลด Resolution ลง
        config.frame_size =
            FRAMESIZE_QVGA;


        config.jpeg_quality = 12;


        // ใช้ Buffer เพียง 1 ชุด
        config.fb_count = 1;


        config.grab_mode =
            CAMERA_GRAB_WHEN_EMPTY;
    }


    // ========================================================
    // เริ่มกล้อง
    // ========================================================

    esp_err_t err =
        esp_camera_init(
            &config
        );


    // หากเริ่มกล้องไม่สำเร็จ
    if(err != ESP_OK)
    {

        Serial.printf(
            "Camera init failed: 0x%x\n",
            err
        );


        return false;
    }


    // ========================================================
    // ตั้งค่าภาพเริ่มต้น
    // ========================================================

    sensor_t *sensor =
        esp_camera_sensor_get();


    if(sensor)
    {

        // ----------------------------------------------
        // Brightness
        // -2 ถึง +2
        // 0 = ปกติ
        // ----------------------------------------------

        sensor->set_brightness(
            sensor,
            0
        );


        // ----------------------------------------------
        // Contrast
        // ----------------------------------------------

        sensor->set_contrast(
            sensor,
            0
        );


        // ----------------------------------------------
        // Saturation
        // ความเข้มของสี
        // ----------------------------------------------

        sensor->set_saturation(
            sensor,
            0
        );


        // ----------------------------------------------
        // Sharpness
        // ความคมชัด
        // ----------------------------------------------

        sensor->set_sharpness(
            sensor,
            0
        );


        // ----------------------------------------------
        // เปิด Auto White Balance
        // ----------------------------------------------

        sensor->set_whitebal(
            sensor,
            1
        );


        // ----------------------------------------------
        // เปิด Auto Exposure
        // ----------------------------------------------

        sensor->set_exposure_ctrl(
            sensor,
            1
        );


        // ----------------------------------------------
        // เปิด Auto Gain
        // ----------------------------------------------

        sensor->set_gain_ctrl(
            sensor,
            1
        );

    }


    // กล้องเริ่มทำงานสำเร็จ
    return true;
}


// ============================================================
// SETUP
// ฟังก์ชันนี้ทำงานครั้งเดียวตอนเปิดเครื่อง
// ============================================================

void setup()
{

    // ========================================================
    // เปิด Serial Monitor
    // ========================================================

    Serial.begin(115200);


    // รอระบบเล็กน้อย
    delay(1000);


    Serial.println();
    Serial.println();

    Serial.println(
        "========================================"
    );

    Serial.println(
        "ESP32-CAM CCTV"
    );

    Serial.println(
        "Standalone Access Point Mode"
    );

    Serial.println(
        "========================================"
    );


    // ========================================================
    // ตั้งค่า Flash LED
    // ========================================================

    pinMode(
        FLASH_LED_PIN,
        OUTPUT
    );


    // ปิด Flash ตอนเปิดเครื่อง
    digitalWrite(
        FLASH_LED_PIN,
        LOW
    );


    // ========================================================
    // เริ่มต้นกล้อง
    // ========================================================

    Serial.println(
        "Starting Camera..."
    );


    // เรียกฟังก์ชัน setupCamera()
    if(!setupCamera())
    {

        Serial.println(
            "Camera Error!"
        );


        // หากกล้อง Error
        // หยุดโปรแกรมไว้ตรงนี้
        while(true)
        {
            delay(1000);
        }
    }


    Serial.println(
        "Camera OK"
    );


    // ========================================================
    // ตั้ง ESP32-CAM เป็น Access Point
    // ========================================================

    // WIFI_AP หมายถึง
    // ESP32 สร้าง WiFi เอง
    //
    // ไม่ต้องใช้ Router
    WiFi.mode(
        WIFI_AP
    );


    // ปิด WiFi Sleep
    // ช่วยลดอาการ Streaming กระตุก
    WiFi.setSleep(false);


    // กำหนด IP ของ Access Point
    WiFi.softAPConfig(
        local_IP,
        gateway,
        subnet
    );


    // ========================================================
    // เปิด WiFi Access Point
    // ========================================================
    //
    // AP_SSID        = ชื่อ WiFi
    // AP_PASSWORD    = รหัสผ่าน
    // 1              = WiFi Channel 1
    // 0              = แสดงชื่อ WiFi
    // 4              = อนุญาตสูงสุด 4 เครื่อง
    // ========================================================

    bool apResult =
        WiFi.softAP(
            AP_SSID,
            AP_PASSWORD,
            1,
            0,
            4
        );


    // ตรวจสอบว่าเปิด WiFi สำเร็จหรือไม่
    if(apResult)
    {

        Serial.println();

        Serial.println(
            "WiFi Access Point Started"
        );

    }

    else
    {

        Serial.println(
            "WiFi AP Failed!"
        );
    }


    // ========================================================
    // แสดงข้อมูลใน Serial Monitor
    // ========================================================

    Serial.println();


    Serial.print(
        "WiFi Name     : "
    );

    Serial.println(
        AP_SSID
    );


    Serial.print(
        "WiFi Password : "
    );

    Serial.println(
        AP_PASSWORD
    );


    Serial.print(
        "Camera IP     : "
    );

    Serial.println(
        WiFi.softAPIP()
    );


    Serial.println();


    Serial.println(
        "เปิดหน้าเว็บไซต์:"
    );

    Serial.println(
        "http://192.168.4.1"
    );


    Serial.println();


    Serial.println(
        "เปิด Video Stream โดยตรง:"
    );

    Serial.println(
        "http://192.168.4.1:81/stream"
    );


    // ========================================================
    // เริ่ม Web Server
    // ========================================================

    startCameraServer();


    Serial.println();

    Serial.println(
        "========================================"
    );

    Serial.println(
        "ESP32-CAM CCTV READY"
    );

    Serial.println(
        "========================================"
    );

}


// ============================================================
// LOOP
// ฟังก์ชันนี้จะทำงานวนซ้ำตลอดเวลา
// ============================================================

void loop()
{

    /*
       เราใช้ esp_http_server

       Library นี้สร้าง Task แยกสำหรับ
       Web Server อยู่แล้ว

       ดังนั้นไม่ต้องใช้

       server.handleClient();

       เหมือน WebServer Library แบบทั่วไป
    */


    // หน่วงเพื่อไม่ให้ Loop ทำงานเร็วเกินไป
    delay(1000);

}
